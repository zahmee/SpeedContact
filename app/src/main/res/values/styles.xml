<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetPreviewTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:src">@drawable/widget_preview_tile</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="WidgetPreviewLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginVertical">6dp</item>
        <item name="android:src">@drawable/widget_preview_line</item>
        <item name="android:scaleType">fitXY</item>
    </style>
</resources>
