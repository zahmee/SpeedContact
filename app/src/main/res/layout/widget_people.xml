<?xml version="1.0" encoding="utf-8"?>
<!--
    Every widget that shows people directly: names, or rows of photos. A real ListView, because some
    launchers only give up their swipe gestures for a list, and keep them over a GridView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:singleLine="true"
            android:textAlignment="viewStart"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- The widget must stay still under a finger: no stretch at the edges and no press frame. -->
        <ListView
            android:id="@+id/widget_people"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="false"
            android:isScrollContainer="true"
            android:listSelector="@android:color/transparent"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_message_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/widget_message_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="14sp" />
        </LinearLayout>

        <!--
            Shown when people do not fit, for launchers that keep the drag to themselves. Its words
            are set from code: a string here would follow the launcher's language, not the app's.
        -->
        <LinearLayout
            android:id="@+id/widget_more_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/widget_page_up"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_up" />

            <TextView
                android:id="@+id/widget_show_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/widget_page_down"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_down" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
